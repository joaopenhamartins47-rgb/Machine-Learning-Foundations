   "id": "7911eec0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "w = np.array([1.0, 2.0, 3.0])\n",
    "b = 4\n",
    "x = np.array([40, 10, 20])\n",
    "n = len(w)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "695e91fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "f = 0\n",
    "for j in range(n):\n",
    "    f = f + w[j] * x[j]\n",
    "f = f+b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "51bf6826",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Vectorization\n",
    "\n",
    "f = np.dot(w, x) + b"
   ]
  }
 ],
